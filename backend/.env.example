# Copy to backend/.env and fill in. Never commit the real .env file.

# development | production | test
APP_ENV=development
# Required in production: a long random string (at least 32 characters).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development, a random key is created automatically in backend/data/.
SECRET_KEY=
TOKEN_TTL_MINUTES=720
# Where the database and private files are kept (default: backend/data)
HAQ_DATA_DIR=
MAX_UPLOAD_MB=20
MAX_MEDIA_UPLOAD_MB=50
# Only needed if the frontend is served from a different origin than the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email: "console" (development: codes appear in the app and server log) or "smtp"
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=HAQ <no-reply@example.com>

# AI for drafting the "What happened" paragraph:
#   local   = no AI, deterministic template (default)
#   watsonx = IBM Granite on IBM watsonx.ai (needs IBM Cloud API key + project ID)
#   ollama  = IBM Granite running on this computer through Ollama
AI_PROVIDER=local
AI_TIMEOUT_SECONDS=60

WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
# Use a Granite model ID listed as available in your watsonx.ai project
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

OLLAMA_URL=http://127.0.0.1:11434
# Use a Granite tag shown by `ollama list` (e.g. after `ollama pull granite3.3:2b`)
OLLAMA_MODEL=granite3.3:2b

# Tesseract OCR languages if installed (e.g. eng+hin+kan)
OCR_LANGUAGES=eng

# Offline speech-to-text for voice notes and videos (Whisper). off, tiny, base or small.
# The model downloads once (base is about 150 MB), then works without internet.
STT_MODEL=base
